<?xml version="1.0" ?>
<robot name="{{ robot.name }}" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Generated by defined-compile --generate-urdf from {{ robot.name }}.rdf.yaml -->
  <!-- Do not edit by hand — edit the RDF file instead. -->

{% if physical.meshes_package %}
  <xacro:property name="meshes_pkg" value="{{ physical.meshes_package }}"/>
{% endif %}

  <!-- ======================================================= -->
  <!-- Links -->
  <!-- ======================================================= -->
{% for link in physical.links %}

  <link name="{{ link.name }}">
{% if link.mass > 0 %}
    <inertial>
      <origin xyz="{{ link.origin.xyz | join(' ') }}" rpy="{{ link.origin.rpy | join(' ') }}"/>
      <mass value="{{ link.mass }}"/>
      <inertia
        ixx="{{ link.inertia.ixx }}" ixy="{{ link.inertia.ixy }}" ixz="{{ link.inertia.ixz }}"
        iyy="{{ link.inertia.iyy }}" iyz="{{ link.inertia.iyz }}" izz="{{ link.inertia.izz }}"/>
    </inertial>
{% endif %}
{% if link.visual %}
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
{% if link.visual.mesh %}
        <mesh filename="package://{{ physical.meshes_package }}/{{ link.visual.mesh.filename }}"/>
{% elif link.visual.box %}
        <box size="{{ link.visual.box.size | join(' ') }}"/>
{% elif link.visual.cylinder %}
        <cylinder radius="{{ link.visual.cylinder.radius }}" length="{{ link.visual.cylinder.length }}"/>
{% elif link.visual.sphere %}
        <sphere radius="{{ link.visual.sphere.radius }}"/>
{% endif %}
      </geometry>
    </visual>
{% endif %}
{% if link.collision %}
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
{% if link.collision.mesh %}
        <mesh filename="package://{{ physical.meshes_package }}/{{ link.collision.mesh.filename }}"/>
{% elif link.collision.box %}
        <box size="{{ link.collision.box.size | join(' ') }}"/>
{% elif link.collision.cylinder %}
        <cylinder radius="{{ link.collision.cylinder.radius }}" length="{{ link.collision.cylinder.length }}"/>
{% elif link.collision.sphere %}
        <sphere radius="{{ link.collision.sphere.radius }}"/>
{% endif %}
      </geometry>
    </collision>
{% endif %}
  </link>
{% endfor %}

  <!-- ======================================================= -->
  <!-- Joints -->
  <!-- ======================================================= -->
{% for joint in physical.joints %}

  <joint name="{{ joint.name }}" type="{{ joint.type }}">
    <parent link="{{ joint.parent }}"/>
    <child link="{{ joint.child }}"/>
    <origin xyz="{{ joint.origin.xyz | join(' ') }}" rpy="{{ joint.origin.rpy | join(' ') }}"/>
{% if joint.axis %}
    <axis xyz="{{ joint.axis | join(' ') }}"/>
{% endif %}
{% if joint.limit %}
    <limit
      lower="{{ joint.limit.get('lower', -3.14159) }}"
      upper="{{ joint.limit.get('upper',  3.14159) }}"
      effort="{{ joint.limit.get('effort', 30.0) }}"
      velocity="{{ joint.limit.get('velocity', 0.5) }}"/>
{% endif %}
  </joint>
{% endfor %}

  <!-- ======================================================= -->
  <!-- Gazebo plugins (derived from capabilities) -->
  <!-- ======================================================= -->
{% for cap in capabilities %}
{% if cap.type == "differential_drive" %}

  <gazebo>
    <plugin name="turtlebot3_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>{{ cap.parameters.wheel_separation }}</wheel_separation>
      <wheel_diameter>{{ cap.parameters.wheel_radius * 2 }}</wheel_diameter>
      <max_wheel_torque>30</max_wheel_torque>
      <max_wheel_acceleration>1.8</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
{% endif %}
{% if cap.type == "lidar_2d" %}

  <gazebo reference="base_scan">
    <material>Gazebo/FlatBlack</material>
    <sensor type="ray" name="lds_lfcd_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>{{ cap.parameters.update_rate }}</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>{{ cap.parameters.samples }}</samples>
            <resolution>1</resolution>
            <min_angle>{{ cap.parameters.scan_angle_min }}</min_angle>
            <max_angle>{{ cap.parameters.scan_angle_max }}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>{{ cap.parameters.range_min }}</min>
          <max>{{ cap.parameters.range_max }}</max>
          <resolution>0.015</resolution>
        </range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="turtlebot3_laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:={{ cap.parameters.topic }}</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>
{% endif %}
{% endfor %}

</robot>
