<?xml version="1.0" ?>
<robot name="{{ robot.name }}" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Generated by defined-compile from {{ robot.name }}.rdf.yaml -->
  <!-- Do not edit by hand. Edit the RDF file instead. -->

{% if physical.meshes_package %}
  <xacro:property name="meshes_pkg" value="{{ physical.meshes_package }}"/>
{% endif %}

  <!-- ======================================================= -->
  <!-- Links -->
  <!-- ======================================================= -->
{% for link in physical.links %}

  <link name="{{ link.name }}">
{% if link.mass > 0 %}
    <inertial>
      <origin xyz="{{ link.origin.xyz | join(' ') }}" rpy="{{ link.origin.rpy | join(' ') }}"/>
      <mass value="{{ link.mass }}"/>
      <inertia
        ixx="{{ link.inertia.ixx }}" ixy="{{ link.inertia.ixy }}" ixz="{{ link.inertia.ixz }}"
        iyy="{{ link.inertia.iyy }}" iyz="{{ link.inertia.iyz }}" izz="{{ link.inertia.izz }}"/>
    </inertial>
{% endif %}
{% if link.visual %}
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
{% if link.visual.mesh %}
        <mesh filename="package://{{ physical.meshes_package }}/{{ link.visual.mesh.filename }}"/>
{% elif link.visual.box %}
        <box size="{{ link.visual.box.size | join(' ') }}"/>
{% elif link.visual.cylinder %}
        <cylinder radius="{{ link.visual.cylinder.radius }}" length="{{ link.visual.cylinder.length }}"/>
{% elif link.visual.sphere %}
        <sphere radius="{{ link.visual.sphere.radius }}"/>
{% endif %}
      </geometry>
    </visual>
{% endif %}
{% if link.collision %}
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
{% if link.collision.mesh %}
        <mesh filename="package://{{ physical.meshes_package }}/{{ link.collision.mesh.filename }}"/>
{% elif link.collision.box %}
        <box size="{{ link.collision.box.size | join(' ') }}"/>
{% elif link.collision.cylinder %}
        <cylinder radius="{{ link.collision.cylinder.radius }}" length="{{ link.collision.cylinder.length }}"/>
{% elif link.collision.sphere %}
        <sphere radius="{{ link.collision.sphere.radius }}"/>
{% endif %}
      </geometry>
    </collision>
{% endif %}
  </link>
{% endfor %}

  <!-- ======================================================= -->
  <!-- Joints -->
  <!-- ======================================================= -->
{% for joint in physical.joints %}

  <joint name="{{ joint.name }}" type="{{ joint.type }}">
    <parent link="{{ joint.parent }}"/>
    <child link="{{ joint.child }}"/>
    <origin xyz="{{ joint.origin.xyz | join(' ') }}" rpy="{{ joint.origin.rpy | join(' ') }}"/>
{% if joint.axis %}
    <axis xyz="{{ joint.axis | join(' ') }}"/>
{% endif %}
{% if joint.limit %}
    <limit
      lower="{{ joint.limit.get('lower', -3.14159) }}"
      upper="{{ joint.limit.get('upper',  3.14159) }}"
      effort="{{ joint.limit.get('effort', 30.0) }}"
      velocity="{{ joint.limit.get('velocity', 0.5) }}"/>
{% endif %}
  </joint>
{% endfor %}

  <!-- ======================================================= -->
  <!-- Gz Sim plugins (derived from capabilities) -->
  <!-- ======================================================= -->
{% for cap in capabilities %}
{% if cap.type == "differential_drive" %}

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>{{ wheel_joints[0] }}</left_joint>
      <right_joint>{{ wheel_joints[1] }}</right_joint>
      <wheel_separation>{{ cap.parameters.wheel_separation }}</wheel_separation>
      <wheel_radius>{{ cap.parameters.wheel_radius }}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>{{ wheel_joints[0] }}</joint_name>
      <joint_name>{{ wheel_joints[1] }}</joint_name>
      <update_rate>50</update_rate>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
{% endif %}
{% if cap.type == "lidar_2d" %}

  <gazebo reference="{{ lidar_link }}">
    <sensor type="gpu_lidar" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>{{ cap.parameters.update_rate }}</update_rate>
      <topic>{{ cap.parameters.topic }}</topic>
      <gz_frame_id>{{ lidar_link }}</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>{{ cap.parameters.samples }}</samples>
            <resolution>1</resolution>
            <min_angle>{{ cap.parameters.scan_angle_min }}</min_angle>
            <max_angle>{{ cap.parameters.scan_angle_max }}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>{{ cap.parameters.range_min }}</min>
          <max>{{ cap.parameters.range_max }}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
{% endif %}
{% if cap.type == "rgb_camera" %}

  <gazebo reference="{{ camera_link }}">
    <sensor type="camera" name="camera_sensor">
      <update_rate>{{ cap.parameters.fps | default(30) }}</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>{{ camera_link }}</gz_frame_id>
      <camera name="camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>{{ cap.parameters.resolution[0] | default(640) }}</width>
          <height>{{ cap.parameters.resolution[1] | default(480) }}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
{% endif %}
{% endfor %}

</robot>
