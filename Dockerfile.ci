# Dockerfile.ci
FROM ghcr.io/defined-robotics/python-base:3.12

# Install git (required for pip install from git+https:// sources)
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Install defined-rdf from source (until published to PyPI)
RUN --mount=type=secret,id=github_token \
    pip install --no-cache-dir \
    "defined-rdf @ git+https://$(cat /run/secrets/github_token)@github.com/Defined-Robotics/defined-rdf.git@trunk"

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

COPY src/ src/
COPY tests/ tests/

CMD ["pytest", "tests/", "-v"]
