# Dockerfile.ci
FROM ghcr.io/defined-robotics/python-base:3.12

# Install git (required for pip install from git+https:// sources)
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Install defined-rdf from source (until published to PyPI)
RUN pip install --no-cache-dir \
    "defined-rdf @ git+https://github.com/Defined-Robotics/rdf.git@trunk"

COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e ".[dev]"

COPY tests/ tests/

CMD ["pytest", "tests/", "-v"]
